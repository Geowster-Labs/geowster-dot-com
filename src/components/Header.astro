---
import MobileNav from './MobileNav';
import { CONTACT_HREF, NAV_LINKS, SITE_TITLE } from '../consts';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = NAV_LINKS.map((link) => ({ ...link, href: url(link.href) }));
---

<header class="container-page flex h-20 items-center justify-between">
  <a href={url('/')} class="text-2xl font-bold tracking-tight">{SITE_TITLE}</a>

  <nav aria-label="Main" class="hidden items-center gap-6 md:flex">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={current === href ? 'page' : undefined}
          class="font-semibold underline-offset-8 transition-colors hover:text-muted aria-[current=page]:underline"
        >
          {label}
        </a>
      ))
    }
    <a
      href={CONTACT_HREF}
      class="ml-2 rounded-xl bg-fg px-5 py-3 font-semibold text-bg transition-opacity hover:opacity-85"
    >
      Get in touch
    </a>
  </nav>

  <MobileNav client:media="(max-width: 767px)" links={links} current={current} contactHref={CONTACT_HREF} />
</header>
