---
interface Props {
  title: string;
  label: string;
  href: string;
  /** Tailwind background class for the thumbnail placeholder. */
  tone: string;
}

const { title, label, href, tone } = Astro.props;
---

<a href={href} class="group flex items-center gap-4">
  <span class:list={['size-24 shrink-0 rounded-xl', tone]} aria-hidden="true"></span>
  <span>
    <span class="line-clamp-2 font-semibold leading-snug group-hover:text-muted">{title}</span>
    <span class="mt-1 block text-sm text-muted">{label}</span>
  </span>
</a>
